<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.GongzuoliangxinxiDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.GongzuoliangxinxiEntity" id="gongzuoliangxinxiMap">
        <result property="lilun" column="lilun"/>
        <result property="shiyan" column="shiyan"/>
        <result property="shixi" column="shixi"/>
        <result property="kechengxishu" column="kechengxishu"/>
        <result property="hebanshuliang" column="hebanshuliang"/>
        <result property="hebanxishu" column="hebanxishu"/>
        <result property="zhidaobiyeshengrenshu" column="zhidaobiyeshengrenshu"/>
        <result property="lunwenjiaoxuegongzuoliang" column="lunwenjiaoxuegongzuoliang"/>
        <result property="shiyanleixingxishu" column="shiyanleixingxishu"/>
        <result property="shiyandiaozhengxishu" column="shiyandiaozhengxishu"/>
        <result property="dangliangxueshi" column="dangliangxueshi"/>
        <result property="beizhu" column="beizhu"/>
        <result property="jiaoshigonghao" column="jiaoshigonghao"/>
        <result property="jiaoshixingming" column="jiaoshixingming"/>
        <result property="tijiaoshijian" column="tijiaoshijian"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.GongzuoliangxinxiView" >

		SELECT  gongzuoliangxinxi.* FROM gongzuoliangxinxi  gongzuoliangxinxi 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.GongzuoliangxinxiView" >
		SELECT * FROM gongzuoliangxinxi  gongzuoliangxinxi <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

    <select id="selectValue" resultType="map" >
        SELECT ${params.xColumn}, ROUND(sum(${params.yColumn}),1) total FROM gongzuoliangxinxi
        <where> 1=1 ${ew.sqlSegment}</where>
        group by ${params.xColumn}
        limit 10
    </select>

    <select id="selectTimeStatValue" resultType="map" >
        <if test = 'params.timeStatType == "日"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y-%m-%d') ${params.xColumn}, sum(${params.yColumn}) total FROM gongzuoliangxinxi
                <where> 1=1 ${ew.sqlSegment}</where>
                group by DATE_FORMAT(${params.xColumn},'%Y-%m-%d')
        </if>
        <if test = 'params.timeStatType == "月"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y-%m') ${params.xColumn}, sum(${params.yColumn}) total FROM gongzuoliangxinxi
                <where> 1=1 ${ew.sqlSegment}</where>
                group by DATE_FORMAT(${params.xColumn},'%Y-%m')
        </if>
        <if test = 'params.timeStatType == "年"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y') ${params.xColumn}, sum(${params.yColumn}) total FROM gongzuoliangxinxi
                <where> 1=1 ${ew.sqlSegment}</where>
                group by DATE_FORMAT(${params.xColumn},'%Y')
        </if>
    </select>

    <select id="selectGroup" resultType="map" >
        SELECT ${params.column} , count(1) total FROM gongzuoliangxinxi
        <where> 1=1 ${ew.sqlSegment}</where>
        group by ${params.column}
        limit 10
    </select>



</mapper>
